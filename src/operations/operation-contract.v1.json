      "key": "core.services",
      "label": "Services",
      "category": "Core",
      "description": "Review the bounded status summary for configured core services.",
      "module": "core",
      "controller": "service",
      "wrapper": "core-services",
      "firmwareTarget": "26",
      "requiredPlugin": null,
